# PostgreSQL connection string used by the app and database tooling.
# `npm run db:migrate:prod`, `db:seed`, and `start:standalone` load this file
# from the repo root (existing shell variables are not overwritten).
#
# Default credentials match docker-compose.yml (user/password/db: opentcm).
# docs/SETUP.md Part B uses password `change-me-in-production` in its SQL
# example — that password must match this URL.
# With Docker Compose, Postgres is published on localhost:5432 — use this URL
# when running the Next.js dev server on your host:
DATABASE_URL=postgresql://opentcm:opentcm@localhost:5432/opentcm
#
# When the app runs inside the compose "app" service, it receives
# DATABASE_URL=postgresql://opentcm:opentcm@postgres:5432/opentcm automatically.
#
# --- Production Docker Compose (docker-compose.prod.yml) ----------------------
# Copy this file to .env and adjust as needed. Compose reads these variables:
#
# POSTGRES_USER=opentcm
# POSTGRES_PASSWORD=opentcm
# POSTGRES_DB=opentcm
# APP_PORT=3000
# OPENTCM_IMAGE=ghcr.io/shanecookofficial/opentcm:latest
# After git tag v0.1.0 is pushed, GHCR also has :v0.1.0 (pin that if you do not
# want :latest to float). Until the tag exists, `docker compose … up --build`.
#
# Set to true on first boot only to load the WEB/API demo dataset
# (same as `npm run db:seed`). Set back to false afterwards — leaving it true
# recreates permanently deleted demo cases on every app-container start.
# SEED_DEMO_DATA=false
#
# First Admin (created only when the users table is empty). Unset the password
# after first boot in production, or leave it — bootstrap is a no-op once any
# user exists. Dev Compose (`docker-compose.yml`) defaults to:
#   admin@opentcm.io / opentcm-admin
# Production Compose does not invent an Admin — set both variables explicitly.
# BOOTSTRAP_ADMIN_EMAIL=admin@opentcm.io
# BOOTSTRAP_ADMIN_PASSWORD=opentcm-admin
#
# Set to true when the app is served over HTTPS so the session cookie gets
# the Secure flag. Leave unset or false for local http:// development.
# HTTPS=false
